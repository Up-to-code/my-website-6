import { clerkMiddleware, createRouteMatcher } from "@clerk/nextjs/server";
import { User, IUser } from "./lib/db/schema/User"; // Assuming User is a Mongoose model
import { connectDB } from "./lib/db/connectDB";
import mongoose from "mongoose";

const isPublicRoute = createRouteMatcher(["/sign-in(.*)", "/sign-up(.*)"]);
const isAdminRoute = createRouteMatcher(["/dashboard(.*)"]); // Adjust as necessary

export default clerkMiddleware(async (auth, request) => {
  // Allow access to public routes without authentication
  if (isPublicRoute(request)) {
    return;
  }
  console.log('Mongoose models:', mongoose.models);

  try {
    // Connect to the database
    await connectDB();

    // Get the user ID from Clerk authentication
    const userId = auth().userId as string | null;

    console.log(userId, "userId");

    if (!userId) {
      return new Response("Authentication Required", { status: 401 }); // 401 Unauthorized if no user ID
    }

    // Find the user by userId (_id in the database)
    const user: IUser | null = await User.findOne({ _id: userId });

    if (!user) {
      return new Response("User not found", { status: 404 }); // 404 Not Found if user doesn't exist
    }

    // If accessing an admin route, check if the user has admin privileges
    if (isAdminRoute(request) && user.role !== "admin") {
      return new Response("Access Denied", { status: 403 }); // 403 Forbidden if not an admin
    }

    // Allow the request to continue if no issues
  } catch (error) {
    console.error("Error in middleware:", error);
    return new Response("Internal Server Error", { status: 500 }); // 500 Internal Server Error for other issues
  }
});

// Configuration to match routes
export const config = {
  matcher: [
    "/((?!_next|[^?]*\\.(?:html?|css|js(?!on)|jpe?g|webp|png|gif|svg|ttf|woff2?|ico|csv|docx?|xlsx?|zip|webmanifest)).*)",
    "/(api|trpc)(.*)",
  ],
};
